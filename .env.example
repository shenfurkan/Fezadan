SITE_URL=https://fezadan.org
NOTES_SITE_URL=https://notlar.fezadan.org
APP_ENV=production
APP_DEBUG=0
APP_SECURITY_SALT=change-me

DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

CDN_URL=https://cdn.fezadan.org

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://cdn.fezadan.org

LITECAPTCHA_ENABLED=1
LITECAPTCHA_URL=http://localhost:8089
LITECAPTCHA_SECRET=change-me

# Optional: donation address shown on the support page.
MONERO_ADDRESS=

# Optional: mail invitation workflow. Needs the cPanel mail API credentials.
MAIL_INVITES_ENABLED=0
CPANEL_MAIL_HOST=
CPANEL_MAIL_USER=
CPANEL_MAIL_TOKEN=

# Optional: override the PHP session directory. Defaults to upload_tmp_dir/sys_temp_dir.
SESSION_SAVE_PATH=
